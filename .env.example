# Copy to .env and fill in. Never commit .env.
# Run with no services at all: SAMPLE_MODE=true (local SQLite copy of the data + recorded model replies)
SAMPLE_MODE=false

# Zetaris (data layer). Create the API key yourself in the Zetaris web UI.
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key
ZETARIS_DB=pathcheck

# Meterless Nightshift (primary AI provider). The NVIDIA key lives in Nightshift's Providers tab, not here.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=copy-from-nightshift-console
METERLESS_APP_ID=pathcheck
# Lanes: Nightshift routing modes or exact model ids (e.g. a Nemotron model id from GET /v1/models)
LANE_FAST=meterless/fast
LANE_DEEP=meterless/deep
LANE_JUDGE=meterless/auto
